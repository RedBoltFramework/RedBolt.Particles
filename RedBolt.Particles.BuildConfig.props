<Project>
  <PropertyGroup>
    <RedBoltParticlesEnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',particles,'))">true</RedBoltParticlesEnabled>
    <RedBoltParticlesEnabled Condition="'$(RedBoltParticlesEnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',particles,'))">true</RedBoltParticlesEnabled>
    <RedBoltParticlesEnabled Condition="'$(RedBoltParticlesEnabled)' == ''">false</RedBoltParticlesEnabled>
  </PropertyGroup>
</Project>
